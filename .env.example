# Application
APP_NAME=PaperPulse
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database
DATABASE_URL=postgresql+asyncpg://paperpulse:password@localhost:5432/paperpulse
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_DB=0
REDIS_CELERY_BROKER_DB=1
REDIS_CELERY_BACKEND_DB=2

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TRACK_STARTED=True
CELERY_TASK_TIME_LIMIT=3600

# Object Storage (S3/MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=paperpulse-pdfs
S3_REGION=us-east-1

# External APIs
# arXiv (no key needed)
ARXIV_MAX_RESULTS=100
ARXIV_RATE_LIMIT_DELAY=3.0

# Semantic Scholar
SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-api-key

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_RETRIES=3

# Anthropic (Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Embedding Models
# BGE-M3 (local)
BGE_MODEL_NAME=BAAI/bge-m3
BGE_MODEL_CACHE_DIR=./models/bge-m3
BGE_USE_FP16=True
BGE_DEVICE=cuda

# Vector Search
VECTOR_SEARCH_HNSW_M=16
VECTOR_SEARCH_HNSW_EF_CONSTRUCTION=64
VECTOR_SEARCH_EF_SEARCH=40

# PDF Processing
PDF_MAX_PAGES=100
PDF_OCR_ENABLED=True
PDF_OCR_LANGUAGE=eng
TESSERACT_CMD=/usr/bin/tesseract

# Knowledge Graph
LIGHTRAG_WORKING_DIR=./data/lightrag
SPACY_MODEL=en_core_sci_lg

# Notification
# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@paperpulse.ai
SMTP_FROM_NAME=PaperPulse

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/app.log

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

# Feature Flags
ENABLE_KNOWLEDGE_GRAPH=True
ENABLE_NOTIFICATIONS=True
ENABLE_RECOMMENDATIONS=True
