# Application
APP_NAME=PaperPulse
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-here-change-in-production

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Database
DATABASE_URL=postgresql://paperpulse:password@localhost:5432/paperpulse
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# S3 / MinIO (for PDF storage)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=paperpulse-pdfs
S3_REGION=us-east-1

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4.5

# BGE Embeddings
BGE_MODEL_NAME=BAAI/bge-m3
BGE_DEVICE=cuda  # or cpu
BGE_MAX_LENGTH=8192

# arXiv
ARXIV_MAX_RESULTS=100
ARXIV_QUERY_INTERVAL=3  # seconds between requests

# Semantic Scholar
SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-api-key
SEMANTIC_SCHOLAR_RATE_LIMIT=100  # requests per 5 minutes

# Papers with Code
PAPERS_WITH_CODE_API_KEY=optional

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@paperpulse.ai

# Slack (for notifications)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Monitoring
PROMETHEUS_PORT=9090
ENABLE_METRICS=true

# LightRAG
LIGHTRAG_WORKING_DIR=./data/lightrag
LIGHTRAG_KG_EXTRACT_MAX_WORKERS=4

# Frontend
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Feature Flags
ENABLE_KNOWLEDGE_GRAPH=true
ENABLE_RECOMMENDATIONS=true
ENABLE_CHATBOT=true
